# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Persistence files with secrets — never commit
.ai-config.json
.capital-credentials.json
.system-settings.json
.users.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Vorlagen bleiben sichtbar (27.09.). `.env*` stammt aus der Next.js-Vorlage
# und faengt auch `.env.local.example` — und weil diese Datei TIEFER liegt als
# die Wurzel-.gitignore, schlaegt sie deren Ausnahme. Gemessen mit
# `git check-ignore -v`. Eine Vorlage enthaelt nur Schluesselnamen und gehoert
# ins Repository; sie still zu verschlucken waere genau die Sorte Falle, die
# hier niemand sucht.
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Mission Control runtime logs
lib/data/mission-control-event-log.json

# Autonomous Trading Evolution runtime memory
lib/data/autonomous-trading-evolution-memory.json

# Lokale Prisma-Entwicklungsdatenbank (Generalkontroll-Fund 03.08.)
# Lag als unverfolgte Datei im Baum und war nur ein `git add .` davon entfernt,
# im Repository zu landen — samt allem, was lokal darin gespeichert wurde.
prisma/dev.db
prisma/dev.db-journal
*.sqlite
*.sqlite3
